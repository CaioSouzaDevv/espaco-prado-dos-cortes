{
   "compilerOptions": {
      "lib": [
         "es2021"
      ],
      "target": "es2022",
      "module": "commonjs",
      "moduleResolution": "node",
      "outDir": "./build",
      "rootDir": "./src",
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "sourceMap": true,
      "strict": true,
      "types": ["node"],
      "typeRoots": ["./src/@types", "./node_modules/@types"]
   }
}
